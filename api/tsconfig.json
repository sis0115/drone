{
  // 서버리스 함수 전용 설정. Vercel 은 엔트리포인트에서 가장 가까운 tsconfig 를 읽는다.
  //
  // 루트 tsconfig 를 쓰면 안 되는 이유:
  //  - "noEmit": true      → 함수 출력이 생성되지 않는다 (FUNCTION_INVOCATION_FAILED 의 원인)
  //  - "paths"             → Vercel 이 path mapping 을 지원하지 않는다고 명시
  //  - "types": vite/client → 함수 런타임과 무관한 브라우저 타입
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  // devServer 는 함수가 아니라 vite 설정용이다. 루트 설정이 타입 체크한다.
  "exclude": ["_lib/devServer.ts"]
}
